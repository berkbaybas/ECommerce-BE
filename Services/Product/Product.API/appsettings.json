{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ECommerceProducts"
  },
  "OAuth": {
    "Authority": "http://localhost:8080/realms/ecommerce",
    "Audience": "product-api",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "product-swagger"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
